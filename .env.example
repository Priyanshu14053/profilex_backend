NODE_ENV=development

PORT=5000

# Remote Aiven MySQL Credentials (Do NOT use localhost)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=profilex
# Set to false for Aiven managed SSL if not using a custom CA certificate file:
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: Path to Aiven CA certificate (ca.pem) if strict SSL validation is desired
DB_CA_CERT=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (e.g. * for development or your Flutter web / client domain)
CORS_ORIGIN=*
